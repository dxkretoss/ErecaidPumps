{
  "components/papa-supermarket/products-by-category-sorting-tabs/skeleton": "{{#if products '>' 0}}\n<div class=\"emthemesModez-section emthemesModez-section--productsByCategorySortingTabs\" data-pbcst-skeleton>\n    <div class=\"emthemesModez-section-inner\">\n        <div class=\"emthemesModez-productsByCategoryTabs emthemesModez-productsByCategoryTabs--sorting emthemesModez-productsByCategoryTabs--supermarket1 emthemesModez-pbcSkeleton\" aria-hidden=\"true\">\n            <ul class=\"tabs\">\n                <li class=\"li-heading\"><h2 class=\"page-heading\">{{#if category}}<a href=\"{{category.url}}\">{{category.name}}</a>{{else}}<a class=\"emthemesModez-pbcSkeleton-headingLink\"><span class=\"emthemesModez-pbcSkeleton-bar emthemesModez-pbcSkeleton-bar--heading\"></span></a>{{/if}}</h2></li>\n                {{#if show_bestselling}}<li class=\"tab{{#if active '==' 'bestselling'}} is-active{{/if}}\"><span class=\"tab-title\">{{lang 'papasupermarket.products_by_category_sorting_tabs.bestselling'}}</span></li>{{/if}}\n                {{#if show_featured}}<li class=\"tab{{#if active '==' 'featured'}} is-active{{/if}}\"><span class=\"tab-title\">{{lang 'papasupermarket.products_by_category_sorting_tabs.featured'}}</span></li>{{/if}}\n                {{#if show_new}}<li class=\"tab{{#if active '==' 'newest'}} is-active{{/if}}\"><span class=\"tab-title\">{{lang 'papasupermarket.products_by_category_sorting_tabs.new'}}</span></li>{{/if}}\n                {{#if show_reviews}}<li class=\"tab{{#if active '==' 'avgcustomerreview'}} is-active{{/if}}\"><span class=\"tab-title\">{{lang 'papasupermarket.products_by_category_sorting_tabs.reviews'}}</span></li>{{/if}}\n            </ul>\n            {{#or showBanner (if subcategories '>' 0)}}\n                <div class=\"emthemesModez-productsByCategoryTabs-details{{#if showBanner}} emthemesModez-productsByCategoryTabs-details--hasImage{{/if}}\">\n                    {{#if showBanner}}\n                        <div class=\"emthemesModez-productsByCategoryTabs-details-image\">\n                            <span class=\"emthemesModez-pbcSkeleton-figure emthemesModez-pbcSkeleton-figure--banner\"></span>\n                        </div>\n                    {{/if}}\n                    {{#if subcategories '>' 0}}\n                        <div class=\"emthemesModez-productsByCategoryTabs-details-sub\">\n                            <h3 class=\"emthemesModez-productsByCategoryTabs-details-sub-heading\">{{lang 'papasupermarket.products_by_category_sorting_tabs.subcategory_title'}}</h3>\n                            <ul class=\"emthemesModez-productsByCategoryTabs-details-sub-list\">\n                                {{#if category}}\n                                    {{#each (limit category.children subcategories)}}\n                                        <li class=\"emthemesModez-productsByCategoryTabs-details-sub-item\"><a href=\"{{url}}\">{{name}}</a></li>\n                                    {{/each}}\n                                {{else}}\n                                    {{#for 1 subcategories}}\n                                        <li class=\"emthemesModez-productsByCategoryTabs-details-sub-item\"><span class=\"emthemesModez-pbcSkeleton-bar emthemesModez-pbcSkeleton-bar--subitem\"></span></li>\n                                    {{/for}}\n                                {{/if}}\n                            </ul>\n                        </div>\n                    {{/if}}\n                </div>\n            {{/or}}\n            <div class=\"tabs-contents\">\n                <section class=\"tab-content is-active\">\n                    <div class=\"emthemesModez-productsByCategoryTabs-products\">\n                        <ul class=\"productGrid{{#if products '==' 5}} productGrid--maxCol5{{/if}}{{#if products '==' 6}} productGrid--maxCol6{{/if}}{{#if products '==' 10}} productGrid--maxCol5{{/if}}{{#if products '==' 15}} productGrid--maxCol5{{/if}}{{#if products '==' 18}} productGrid--maxCol6{{/if}}{{#if products '==' 12}}{{#unless (if subcategories '>' 0)}} productGrid--maxCol6{{/unless}}{{/if}}\">\n                            {{#for 1 products}}\n                                <li class=\"product\">\n                                    <article class=\"card\">\n                                        <figure class=\"card-figure\">\n                                            <span class=\"emthemesModez-pbcSkeleton-figure\"></span>\n                                            <figcaption class=\"card-figcaption\">\n                                                <div class=\"card-figcaption-body\">\n                                                    <div class=\"card-buttons\">\n                                                        <span class=\"button button--small button--primary card-figcaption-button emthemesModez-pbcSkeleton-button\">&nbsp;</span>\n                                                    </div>\n                                                </div>\n                                            </figcaption>\n                                        </figure>\n                                        <div class=\"card-body\">\n                                            <h4 class=\"card-title\">\n                                                <span class=\"emthemesModez-pbcSkeleton-bar emthemesModez-pbcSkeleton-bar--line\"></span>\n                                                <span class=\"emthemesModez-pbcSkeleton-bar emthemesModez-pbcSkeleton-bar--line emthemesModez-pbcSkeleton-bar--short\"></span>\n                                            </h4>\n                                            <p class=\"card-text card-text--brand\"><span class=\"emthemesModez-pbcSkeleton-bar emthemesModez-pbcSkeleton-bar--brand\"></span></p>\n                                            <p class=\"card-text card-text--rating\"><span class=\"emthemesModez-pbcSkeleton-bar emthemesModez-pbcSkeleton-bar--rating\"></span></p>\n                                            <div class=\"card-text card-text--price\"><span class=\"emthemesModez-pbcSkeleton-bar emthemesModez-pbcSkeleton-bar--price\"></span></div>\n                                        </div>\n                                    </article>\n                                </li>\n                            {{/for}}\n                        </ul>\n                    </div>\n                </section>\n            </div>\n            <div class=\"emthemesModez-productsByCategoryTabs-actionGroup\">\n                <span class=\"button button--small emthemesModez-pbcSkeleton-button\">&nbsp;</span>\n            </div>\n        </div>\n    </div>\n</div>\n{{/if}}\n"
}