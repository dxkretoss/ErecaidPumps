\">\r\n                            <path d=\"M1 1L5 5L9 1\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/>\r\n                        </svg>\r\n                    </a>\r\n                    <ul class=\"erecaid-header__dropdown\">\r\n                        <li class=\"erecaid-header__dropdown-item\"><a class=\"erecaid-header__dropdown-link\" href=\"/categories\">All ED Vacuum Pumps</a></li>\r\n                        <li class=\"erecaid-header__dropdown-item\"><a class=\"erecaid-header__dropdown-link\" href=\"/categories\">Osbon ErecAid Esteem Manual Pump</a></li>\r\n                        <li class=\"erecaid-header__dropdown-item\"><a class=\"erecaid-header__dropdown-link\" href=\"/categories\">Automatic &amp; Rechargeable Pumps</a></li>\r\n                        <li class=\"erecaid-header__dropdown-item\"><a class=\"erecaid-header__dropdown-link\" href=\"/categories\">Medical Vacuum Therapy Starter Kits</a></li>\r\n                    </ul>\r\n                </li>\r\n\r\n                {{!-- 2. After Prostate Surgery --}}\r\n                <li class=\"erecaid-header__nav-item has-dropdown\">\r\n                    <a class=\"erecaid-header__nav-link\" href=\"/categories\">\r\n                        <span>After Prostate Surgery</span>\r\n                        <svg class=\"erecaid-header__nav-chevron\" width=\"9\" height=\"5\" viewBox=\"0 0 10 6\" fill=\"none\" aria-hidden=\"true\">\r\n                            <path d=\"M1 1L5 5L9 1\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/>\r\n                        </svg>\r\n                    </a>\r\n                    <ul class=\"erecaid-header__dropdown\">\r\n                        <li class=\"erecaid-header__dropdown-item\"><a class=\"erecaid-header__dropdown-link\" href=\"/categories\">Post-Prostatectomy Penile Rehabilitation</a></li>\r\n                        <li class=\"erecaid-header__dropdown-item\"><a class=\"erecaid-header__dropdown-link\" href=\"/categories\">Recovery Vacuum Pump Systems</a></li>\r\n                        <li class=\"erecaid-header__dropdown-item\"><a class=\"erecaid-header__dropdown-link\" href=\"/categories\">Doctor &amp; Urologist Recommended Protocols</a></li>\r\n                    </ul>\r\n                </li>\r\n\r\n                {{!-- 3. Tension Rings --}}\r\n                <li class=\"erecaid-header__nav-item has-dropdown\">\r\n                    <a class=\"erecaid-header__nav-link\" href=\"/categories\">\r\n                        <span>Tension Rings</span>\r\n                        <svg class=\"erecaid-header__nav-chevron\" width=\"9\" height=\"5\" viewBox=\"0 0 10 6\" fill=\"none\" aria-hidden=\"true\">\r\n                            <path d=\"M1 1L5 5L9 1\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/>\r\n                        </svg>\r\n                    </a>\r\n                    <ul class=\"erecaid-header__dropdown\">\r\n                        <li class=\"erecaid-header__dropdown-item\"><a class=\"erecaid-header__dropdown-link\" href=\"/categories\">All Tension Rings</a></li>\r\n                        <li class=\"erecaid-header__dropdown-item\"><a class=\"erecaid-header__dropdown-link\" href=\"/categories\">Standard Tension Rings (A, B, C, D)</a></li>\r\n                        <li class=\"erecaid-header__dropdown-item\"><a class=\"erecaid-header__dropdown-link\" href=\"/categories\">Ultimate Tension Rings</a></li>\r\n                        <li class=\"erecaid-header__dropdown-item\"><a class=\"erecaid-header__dropdown-link\" href=\"/categories\">Ring Sizing &amp; Fitting Guide</a></li>\r\n                    </ul>\r\n                </li>\r\n\r\n                {{!-- 4. Parts & Accessories --}}\r\n                <li class=\"erecaid-header__nav-item has-dropdown\">\r\n                    <a class=\"erecaid-header__nav-link\" href=\"/categories\">\r\n                        <span>Parts &amp; Accessories</span>\r\n                        <svg class=\"erecaid-header__nav-chevron\" width=\"9\" height=\"5\" viewBox=\"0 0 10 6\" fill=\"none\" aria-hidden=\"true\">\r\n                            <path d=\"M1 1L5 5L9 1\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/>\r\n                        </svg>\r\n                    </a>\r\n                    <ul class=\"erecaid-header__dropdown\">\r\n                        <li class=\"erecaid-header__dropdown-item\"><a class=\"erecaid-header__dropdown-link\" href=\"/categories\">All Parts &amp; Accessories</a></li>\r\n                        <li class=\"erecaid-header__dropdown-item\"><a class=\"erecaid-header__dropdown-link\" href=\"/categories\">Replacement Cylinders &amp; Sizing Inserts</a></li>\r\n                        <li class=\"erecaid-header__dropdown-item\"><a class=\"erecaid-header__dropdown-link\" href=\"/categories\">Hoses, Adapters &amp; Pressure Release Valves</a></li>\r\n                        <li class=\"erecaid-header__dropdown-item\"><a class=\"erecaid-header__dropdown-link\" href=\"/categories\">Medical-Grade Lubricating Jelly</a></li>\r\n                    </ul>\r\n                </li>\r\n\r\n                {{!-- 5. Compare Pumps (Direct link - no chevron) --}}\r\n                <li class=\"erecaid-header__nav-item\">\r\n                    <a class=\"erecaid-header__nav-link\" href=\"/categories\">\r\n                        <span>Compare Pumps</span>\r\n                    </a>\r\n                </li>\r\n\r\n                {{!-- 6. How to Use --}}\r\n                <li class=\"erecaid-header__nav-item has-dropdown\">\r\n                    <a class=\"erecaid-header__nav-link\" href=\"/video-instructions-on-how-to-use-erection-pumps/\">\r\n                        <span>How to Use</span>\r\n                        <svg class=\"erecaid-header__nav-chevron\" width=\"9\" height=\"5\" viewBox=\"0 0 10 6\" fill=\"none\" aria-hidden=\"true\">\r\n                            <path d=\"M1 1L5 5L9 1\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/>\r\n                        </svg>\r\n                    </a>\r\n                    <ul class=\"erecaid-header__dropdown\">\r\n                        <li class=\"erecaid-header__dropdown-item\"><a class=\"erecaid-header__dropdown-link\" href=\"/video-instructions-on-how-to-use-erection-pumps/\">Video Instructions on How to Use Pumps</a></li>\r\n                        <li class=\"erecaid-header__dropdown-item\"><a class=\"erecaid-header__dropdown-link\" href=\"/ed-treatment-guide/\">ED Treatment &amp; Usage Guide</a></li>\r\n                        <li class=\"erecaid-header__dropdown-item\"><a class=\"erecaid-header__dropdown-link\" href=\"/categories\">User Manuals &amp; PDF Downloads</a></li>\r\n                    </ul>\r\n                </li>\r\n\r\n                {{!-- 7. Help --}}\r\n                <li class=\"erecaid-header__nav-item has-dropdown\">\r\n                    <a class=\"erecaid-header__nav-link\" href=\"/contact-us-privacy-policy/\">\r\n                        <span>Help</span>\r\n                        <svg class=\"erecaid-header__nav-chevron\" width=\"9\" height=\"5\" viewBox=\"0 0 10 6\" fill=\"none\" aria-hidden=\"true\">\r\n                            <path d=\"M1 1L5 5L9 1\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/>\r\n                        </svg>\r\n                    </a>\r\n                    <ul class=\"erecaid-header__dropdown\">\r\n                        <li class=\"erecaid-header__dropdown-item\"><a class=\"erecaid-header__dropdown-link\" href=\"/ed-assist-faq/\">ED Assist &amp; FAQs</a></li>\r\n                        <li class=\"erecaid-header__dropdown-item\"><a class=\"erecaid-header__dropdown-link\" href=\"/contact-us-privacy-policy/\">Contact Us / Privacy Policy</a></li>\r\n                        <li class=\"erecaid-header__dropdown-item\"><a class=\"erecaid-header__dropdown-link\" href=\"/shipping-returns/\">Shipping &amp; Returns</a></li>\r\n                        <li class=\"erecaid-header__dropdown-item\"><a class=\"erecaid-header__dropdown-link\" href=\"tel:{{#if theme_settings.custom_header_phone}}{{theme_settings.custom_header_phone}}{{else}}866-496-7359{{/if}}\">Call Specialist: {{#if theme_settings.custom_header_phone}}{{theme_settings.custom_header_phone}}{{else}}866-496-7359{{/if}}</a></li>\r\n                    </ul>\r\n                </li>\r\n            </ul>\r\n        </div>\r\n    </nav>\r\n</header>\r\n\r\n<script>\r\n(function() {\r\n    var toggle = document.querySelector('.erecaid-header__mobile-toggle');\r\n    var menu = document.querySelector('.erecaid-header__nav');\r\n    if (toggle && menu) {\r\n        toggle.addEventListener('click', function(e) {\r\n            e.preventDefault();\r\n            menu.classList.toggle('is-open');\r\n        });\r\n    }\r\n\r\n    // On mobile screens, toggle dropdown when chevron/link tapped\r\n    var dropdownItems = document.querySelectorAll('.erecaid-header__nav-item.has-dropdown');\r\n    dropdownItems.forEach(function(item) {\r\n        var link = item.querySelector('.erecaid-header__nav-link');\r\n        var dropdown = item.querySelector('.erecaid-header__dropdown');\r\n        if (link && dropdown) {\r\n            link.addEventListener('click', function(e) {\r\n                if (window.innerWidth <= 900) {\r\n                    e.preventDefault();\r\n                    dropdown.classList.toggle('is-open');\r\n                }\r\n            });\r\n        }\r\n    });\r\n})();\r\n</script>"
