{
  "components/papathemes/socialproof/urgency": "{{!-- Papathemes Social Proof — PDP urgency widget (viewers-now + last-purchased).\n      Rendered inside product-view.html. JS (urgency.js) fills content via data-* attrs.\n      Markup is intentionally empty initially; JS populates children.\n      Config lives in window.supermarketThemeSettings.urgency (Script Manager). --}}\n<div class=\"papathemes-socialproof-urgency\"\n     data-papathemes-urgency\n     data-product-id=\"{{product.id}}\"\n     data-out-of-stock=\"{{product.out_of_stock}}\"\n     data-lang-viewing-now=\"{{lang 'socialproof.urgency.viewing_now'}}\"\n     data-lang-viewing-now-singular=\"{{lang 'socialproof.urgency.viewing_now_singular'}}\"\n     data-lang-last-ordered=\"{{lang 'socialproof.urgency.last_ordered'}}\"\n     data-lang-min-ago=\"{{lang 'socialproof.urgency.min_ago'}}\"\n     data-lang-hour-ago=\"{{lang 'socialproof.urgency.hour_ago'}}\"\n     data-lang-hours-ago=\"{{lang 'socialproof.urgency.hours_ago'}}\"\n     data-lang-day-ago=\"{{lang 'socialproof.urgency.day_ago'}}\"\n     data-lang-days-ago=\"{{lang 'socialproof.urgency.days_ago'}}\"\n     aria-label=\"{{lang 'socialproof.urgency.aria_label'}}\"\n     role=\"status\"\n     aria-live=\"polite\"\n     aria-atomic=\"true\">\n</div>\n"
}