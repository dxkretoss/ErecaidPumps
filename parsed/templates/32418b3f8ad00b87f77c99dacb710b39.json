{
  "components/custom/erecaid-pump-finder": "{{!-- \r\n    ErecAid Interactive Pump Finder Section\r\n    100% matches reference screenshot:\r\n    - Left: Headline & Subtitle\r\n    - Right: Call phone support with double chat bubble icon\r\n    - 3-step dropdown questionnaire in individual boxed cards with chevron separators\r\n    - Action button \"Find My Pump →\" vertically centered\r\n--}}\r\n<section class=\"erecaid-finder-section\" aria-label=\"Pump Finder Questionnaire\">\r\n    <div class=\"container\">\r\n        <div class=\"erecaid-finder-card\">\r\n            {{!-- Top Row: Headline + Call Support --}}\r\n            <div class=\"erecaid-finder-card__top\">\r\n                <div class=\"erecaid-finder-card__heading-wrap\">\r\n                    <h2 class=\"erecaid-finder-card__title\">{{#if theme_settings.custom_finder_title}}{{theme_settings.custom_finder_title}}{{else}}Find the Right Pump for You{{/if}}</h2>\r\n                    <p class=\"erecaid-finder-card__sub\">{{#if theme_settings.custom_finder_sub}}{{theme_settings.custom_finder_sub}}{{else}}Answer a few simple questions and we'll help you find the best options.{{/if}}</p>\r\n                </div>\r\n\r\n                <div class=\"erecaid-finder-card__support\">\r\n                    <div class=\"erecaid-finder-card__support-icon\" aria-hidden=\"true\">\r\n                        <svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#0055ad\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\r\n                            <path d=\"M14 9a2 2 0 0 1-2 2H6l-4 4V4c0-1.1.9-2 2-2h8a2 2 0 0 1 2 2v5Z\"/>\r\n                            <path d=\"M18 9h2a2 2 0 0 1 2 2v11l-4-4h-6a2 2 0 0 1-2-2v-1\"/>\r\n                        </svg>\r\n                    </div>\r\n                    <div class=\"erecaid-finder-card__support-text\">\r\n                        <span class=\"erecaid-finder-card__support-label\">{{#if theme_settings.custom_finder_support_label}}{{theme_settings.custom_finder_support_label}}{{else}}Prefer to talk to someone?{{/if}}</span>\r\n                        <a href=\"tel:{{#if theme_settings.custom_header_phone}}{{theme_settings.custom_header_phone}}{{else}}866-496-7359{{/if}}\" class=\"erecaid-finder-card__support-phone\">\r\n                            Call <strong>{{#if theme_settings.custom_header_phone}}{{theme_settings.custom_header_phone}}{{else}}866-496-7359{{/if}}</strong>\r\n                        </a>\r\n                    </div>\r\n                </div>\r\n            </div>\r\n\r\n            {{!-- Bottom Row: 3 Step Boxes + Chevrons + Submit Button --}}\r\n            <form class=\"erecaid-finder-card__form\" action=\"{{#if theme_settings.custom_finder_btn_url}}{{theme_settings.custom_finder_btn_url}}{{else}}/categories{{/if}}\" method=\"GET\" data-erecaid-finder-form>\r\n                {{!-- Step 1 Box --}}\r\n                <div class=\"erecaid-finder-card__step-box\">\r\n                    <div class=\"erecaid-finder-card__step-header\">\r\n                        <span class=\"erecaid-finder-card__step-num\">1</span>\r\n                        <label class=\"erecaid-finder-card__step-label\" for=\"finder-step-1\">\r\n                            {{#if theme_settings.custom_finder_step1_label}}{{theme_settings.custom_finder_step1_label}}{{else}}What will you primarily use the device for?{{/if}}\r\n                        </label>\r\n                    </div>\r\n                    <div class=\"erecaid-finder-card__select-wrap\">\r\n                        <select id=\"finder-step-1\" name=\"purpose\" class=\"erecaid-finder-card__select\" aria-label=\"Device Purpose\">\r\n                            <option value=\"\" selected disabled>Select an option</option>\r\n                            <option value=\"ed\">Erectile Dysfunction (ED) Treatment</option>\r\n                            <option value=\"prostate\">Post-Prostatectomy Recovery / Rehabilitation</option>\r\n                            <option value=\"peyronie\">Peyronie's Disease Therapy</option>\r\n                            <option value=\"general\">General Penile Health &amp; Wellness</option>\r\n                        </select>\r\n                    </div>\r\n                </div>\r\n\r\n                {{!-- Step Separator Chevron --}}\r\n                <div class=\"erecaid-finder-card__separator\" aria-hidden=\"true\">\r\n                    <svg width=\"7\" height=\"12\" viewBox=\"0 0 7 12\" fill=\"none\">\r\n                        <path d=\"M1 1L6 6L1 11\" stroke=\"#002d62\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/>\r\n                    </svg>\r\n                </div>\r\n\r\n                {{!-- Step 2 Box --}}\r\n                <div class=\"erecaid-finder-card__step-box\">\r\n                    <div class=\"erecaid-finder-card__step-header\">\r\n                        <span class=\"erecaid-finder-card__step-num\">2</span>\r\n                        <label class=\"erecaid-finder-card__step-label\" for=\"finder-step-2\">\r\n                            {{#if theme_settings.custom_finder_step2_label}}{{theme_settings.custom_finder_step2_label}}{{else}}Which type of pump do you prefer?{{/if}}\r\n                        </label>\r\n                    </div>\r\n                    <div class=\"erecaid-finder-card__select-wrap\">\r\n                        <select id=\"finder-step-2\" name=\"pump_type\" class=\"erecaid-finder-card__select\" aria-label=\"Pump Type\">\r\n                            <option value=\"\" selected disabled>Select an option</option>\r\n                            <option value=\"manual\">Manual (Hand / Lever Operation)</option>\r\n                            <option value=\"automatic\">Automatic / Battery Powered</option>\r\n                            <option value=\"rechargeable\">Rechargeable Electronic System</option>\r\n                            <option value=\"all\">No Preference / Show All</option>\r\n                        </select>\r\n                    </div>\r\n                </div>\r\n\r\n                {{!-- Step Separator Chevron --}}\r\n                <div class=\"erecaid-finder-card__separator\" aria-hidden=\"true\">\r\n                    <svg width=\"7\" height=\"12\" viewBox=\"0 0 7 12\" fill=\"none\">\r\n                        <path d=\"M1 1L6 6L1 11\" stroke=\"#002d62\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/>\r\n                    </svg>\r\n                </div>\r\n\r\n                {{!-- Step 3 Box --}}\r\n                <div class=\"erecaid-finder-card__step-box\">\r\n                    <div class=\"erecaid-finder-card__step-header\">\r\n                        <span class=\"erecaid-finder-card__step-num\">3</span>\r\n                        <label class=\"erecaid-finder-card__step-label\" for=\"finder-step-3\">\r\n                            {{#if theme_settings.custom_finder_step3_label}}{{theme_settings.custom_finder_step3_label}}{{else}}Is easy operation important to you?{{/if}}\r\n                        </label>\r\n                    </div>\r\n                    <div class=\"erecaid-finder-card__select-wrap\">\r\n                        <select id=\"finder-step-3\" name=\"easy_operation\" class=\"erecaid-finder-card__select\" aria-label=\"Easy Operation Preference\">\r\n                            <option value=\"\" selected disabled>Select an option</option>\r\n                            <option value=\"one-touch\">Yes - Need One-Touch / Effortless Operation</option>\r\n                            <option value=\"standard\">Somewhat - Standard Operation is Fine</option>\r\n                            <option value=\"full-manual\">No - Prefer Full Manual Control</option>\r\n                        </select>\r\n                    </div>\r\n                </div>\r\n\r\n                {{!-- Submit Button --}}\r\n                <div class=\"erecaid-finder-card__action\">\r\n                    <button type=\"submit\" class=\"erecaid-finder-card__btn\">\r\n                        {{#if theme_settings.custom_finder_btn_text}}{{theme_settings.custom_finder_btn_text}}{{else}}Find My Pump{{/if}} <span class=\"erecaid-finder-card__btn-arrow\">&rarr;</span>\r\n                    </button>\r\n                </div>\r\n            </form>\r\n        </div>\r\n    </div>\r\n</section>\r\n\r\n<script>\r\n(function() {\r\n    var form = document.querySelector('[data-erecaid-finder-form]');\r\n    if (!form) return;\r\n    var defaultUrl = form.getAttribute('action') || '/categories';\r\n    form.addEventListener('submit', function(e) {\r\n        var purpose = form.elements['purpose'] ? form.elements['purpose'].value : '';\r\n        var pumpType = form.elements['pump_type'] ? form.elements['pump_type'].value : '';\r\n        \r\n        if (purpose === 'prostate') {\r\n            form.action = defaultUrl;\r\n        } else if (pumpType === 'manual') {\r\n            form.action = defaultUrl;\r\n        } else if (pumpType === 'automatic' || pumpType === 'rechargeable') {\r\n            form.action = defaultUrl;\r\n        } else {\r\n            form.action = defaultUrl;\r\n        }\r\n    });\r\n})();\r\n</script>"
}