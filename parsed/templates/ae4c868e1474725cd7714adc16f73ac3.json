{
  "components/papathemes/socialproof/cart-goal-bar": "{{!-- Papathemes Social Proof — Cart shipping goal bar.\n      Renders inside cart page summary and mini cart summary.\n      JS (cartGoalBar.js) replaces the skeleton with actual bar + markers + labels.\n      Config lives in window.supermarketThemeSettings.cartGoal (Script Manager). --}}\n{{#or customer (unless settings.hide_price_from_guests)}}\n    <div class=\"papathemes-socialproof-cart-goal\"\n         data-papathemes-cart-goal\n         data-subtotal=\"{{cart.sub_total.value}}\"\n         data-currency-code=\"{{cart.sub_total.currency}}\"\n         data-customer-logged-in=\"{{#if customer}}true{{else}}false{{/if}}\"\n         data-lang-remaining=\"{{lang 'socialproof.cart_goal.message_remaining'}}\"\n         data-lang-all-met=\"{{lang 'socialproof.cart_goal.message_all_met'}}\"\n         aria-live=\"polite\"\n         aria-busy=\"true\">\n        <div class=\"papathemes-socialproof-cart-goal__skeleton\" aria-hidden=\"true\">\n            <div class=\"papathemes-socialproof-cart-goal__skeleton-line\"></div>\n            <div class=\"papathemes-socialproof-cart-goal__skeleton-bar\"></div>\n            <div class=\"papathemes-socialproof-cart-goal__skeleton-labels\"></div>\n        </div>\n    </div>\n{{/or}}\n"
}