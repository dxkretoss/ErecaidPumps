  "components/custom/erecaid-category-cards": "{{!-- \r\n    ErecAid Category Feature Cards Section\r\n    4-Column Feature Grid matching reference design (Screenshot 1)\r\n    - Heading and subtitle via code\r\n    - Middle extracted product kit image\r\n    - Bottom action button via code\r\n--}}\r\n<section class=\"erecaid-cat-section\" aria-label=\"Product Categories\">\r\n    <div class=\"container\">\r\n        <div class=\"erecaid-cat-grid\">\r\n            {{!-- Card 1: Manual Pumps --}}\r\n            <div class=\"erecaid-cat-card\">\r\n                <div class=\"erecaid-cat-card__header\">\r\n                    <h3 class=\"erecaid-cat-card__title\">\r\n                        {{#if theme_settings.custom_cat1_title}}{{theme_settings.custom_cat1_title}}{{else}}Manual Pumps{{/if}}\r\n                    </h3>\r\n                    <p class=\"erecaid-cat-card__sub\">\r\n                        {{#if theme_settings.custom_cat1_sub}}{{theme_settings.custom_cat1_sub}}{{else}}Simple, dependable and easy to control.{{/if}}\r\n                    </p>\r\n                </div>\r\n                <div class=\"erecaid-cat-card__media\">\r\n                    <img src=\"{{#if theme_settings.custom_cat1_img}}{{#startsWith 'http' theme_settings.custom_cat1_img}}{{theme_settings.custom_cat1_img}}{{else}}{{#startsWith '/' theme_settings.custom_cat1_img}}{{theme_settings.custom_cat1_img}}{{else}}/images/stencil/original/image-manager/{{theme_settings.custom_cat1_img}}{{/startsWith}}{{/startsWith}}{{else}}{{cdn 'assets/img/cat-prod-1.png'}}{{/if}}\" \r\n                         alt=\"{{#if theme_settings.custom_cat1_title}}{{theme_settings.custom_cat1_title}}{{else}}Manual Pumps{{/if}}\" \r\n                         loading=\"lazy\">\r\n                </div>\r\n                <div class=\"erecaid-cat-card__footer\">\r\n                    <a href=\"{{#if theme_settings.custom_cat1_url}}{{theme_settings.custom_cat1_url}}{{else}}/categories{{/if}}\" class=\"erecaid-cat-card__btn\">\r\n                        {{#if theme_settings.custom_cat1_btn}}{{theme_settings.custom_cat1_btn}}{{else}}Shop Manual Pumps{{/if}} <span class=\"erecaid-cat-card__btn-arrow\">&rarr;</span>\r\n                    </a>\r\n                </div>\r\n            </div>\r\n\r\n            {{!-- Card 2: Automatic & Rechargeable Pumps --}}\r\n            <div class=\"erecaid-cat-card\">\r\n                <div class=\"erecaid-cat-card__header\">\r\n                    <h3 class=\"erecaid-cat-card__title\">\r\n                        {{#if theme_settings.custom_cat2_title}}{{theme_settings.custom_cat2_title}}{{else}}Automatic &amp; Rechargeable Pumps{{/if}}\r\n                    </h3>\r\n                    <p class=\"erecaid-cat-card__sub\">\r\n                        {{#if theme_settings.custom_cat2_sub}}{{theme_settings.custom_cat2_sub}}{{else}}Convenient powered operation.{{/if}}\r\n                    </p>\r\n                </div>\r\n                <div class=\"erecaid-cat-card__media\">\r\n                    <img src=\"{{#if theme_settings.custom_cat2_img}}{{#startsWith 'http' theme_settings.custom_cat2_img}}{{theme_settings.custom_cat2_img}}{{else}}{{#startsWith '/' theme_settings.custom_cat2_img}}{{theme_settings.custom_cat2_img}}{{else}}/images/stencil/original/image-manager/{{theme_settings.custom_cat2_img}}{{/startsWith}}{{/startsWith}}{{else}}{{cdn 'assets/img/cat-prod-2.png'}}{{/if}}\" \r\n                         alt=\"{{#if theme_settings.custom_cat2_title}}{{theme_settings.custom_cat2_title}}{{else}}Automatic &amp; Rechargeable Pumps{{/if}}\" \r\n                         loading=\"lazy\">\r\n                </div>\r\n                <div class=\"erecaid-cat-card__footer\">\r\n                    <a href=\"{{#if theme_settings.custom_cat2_url}}{{theme_settings.custom_cat2_url}}{{else}}/categories{{/if}}\" class=\"erecaid-cat-card__btn\">\r\n                        {{#if theme_settings.custom_cat2_btn}}{{theme_settings.custom_cat2_btn}}{{else}}Shop Automatic Pumps{{/if}} <span class=\"erecaid-cat-card__btn-arrow\">&rarr;</span>\r\n                    </a>\r\n                </div>\r\n            </div>\r\n\r\n            {{!-- Card 3: After Prostate Surgery --}}\r\n            <div class=\"erecaid-cat-card\">\r\n                <div class=\"erecaid-cat-card__header\">\r\n                    <h3 class=\"erecaid-cat-card__title\">\r\n                        {{#if theme_settings.custom_cat3_title}}{{theme_settings.custom_cat3_title}}{{else}}After Prostate Surgery{{/if}}\r\n                    </h3>\r\n                    <p class=\"erecaid-cat-card__sub\">\r\n                        {{#if theme_settings.custom_cat3_sub}}{{theme_settings.custom_cat3_sub}}{{else}}Support your recovery with a trusted vacuum therapy option.{{/if}}\r\n                    </p>\r\n                </div>\r\n                <div class=\"erecaid-cat-card__media\">\r\n                    <img src=\"{{#if theme_settings.custom_cat3_img}}{{#startsWith 'http' theme_settings.custom_cat3_img}}{{theme_settings.custom_cat3_img}}{{else}}{{#startsWith '/' theme_settings.custom_cat3_img}}{{theme_settings.custom_cat3_img}}{{else}}/images/stencil/original/image-manager/{{theme_settings.custom_cat3_img}}{{/startsWith}}{{/startsWith}}{{else}}{{cdn 'assets/img/cat-prod-3.png'}}{{/if}}\" \r\n                         alt=\"{{#if theme_settings.custom_cat3_title}}{{theme_settings.custom_cat3_title}}{{else}}After Prostate Surgery{{/if}}\" \r\n                         loading=\"lazy\">\r\n                </div>\r\n                <div class=\"erecaid-cat-card__footer\">\r\n                    <a href=\"{{#if theme_settings.custom_cat3_url}}{{theme_settings.custom_cat3_url}}{{else}}/categories{{/if}}\" class=\"erecaid-cat-card__btn\">\r\n                        {{#if theme_settings.custom_cat3_btn}}{{theme_settings.custom_cat3_btn}}{{else}}Learn More{{/if}} <span class=\"erecaid-cat-card__btn-arrow\">&rarr;</span>\r\n                    </a>\r\n                </div>\r\n            </div>\r\n\r\n            {{!-- Card 4: Tension Rings & Accessories --}}\r\n            <div class=\"erecaid-cat-card\">\r\n                <div class=\"erecaid-cat-card__header\">\r\n                    <h3 class=\"erecaid-cat-card__title\">\r\n                        {{#if theme_settings.custom_cat4_title}}{{theme_settings.custom_cat4_title}}{{else}}Tension Rings &amp; Accessories{{/if}}\r\n                    </h3>\r\n                    <p class=\"erecaid-cat-card__sub\">\r\n                        {{#if theme_settings.custom_cat4_sub}}{{theme_settings.custom_cat4_sub}}{{else}}Replacement rings, cylinders, seals and more.{{/if}}\r\n                    </p>\r\n                </div>\r\n                <div class=\"erecaid-cat-card__media\">\r\n                    <img src=\"{{#if theme_settings.custom_cat4_img}}{{#startsWith 'http' theme_settings.custom_cat4_img}}{{theme_settings.custom_cat4_img}}{{else}}{{#startsWith '/' theme_settings.custom_cat4_img}}{{theme_settings.custom_cat4_img}}{{else}}/images/stencil/original/image-manager/{{theme_settings.custom_cat4_img}}{{/startsWith}}{{/startsWith}}{{else}}{{cdn 'assets/img/cat-prod-4.png'}}{{/if}}\" \r\n                         alt=\"{{#if theme_settings.custom_cat4_title}}{{theme_settings.custom_cat4_title}}{{else}}Tension Rings &amp; Accessories{{/if}}\" \r\n                         loading=\"lazy\">\r\n                </div>\r\n                <div class=\"erecaid-cat-card__footer\">\r\n                    <a href=\"{{#if theme_settings.custom_cat4_url}}{{theme_settings.custom_cat4_url}}{{else}}/categories{{/if}}\" class=\"erecaid-cat-card__btn\">\r\n                        {{#if theme_settings.custom_cat4_btn}}{{theme_settings.custom_cat4_btn}}{{else}}Shop Accessories{{/if}} <span class=\"erecaid-cat-card__btn-arrow\">&rarr;</span>\r\n                    </a>\r\n                </div>\r\n            </div>\r\n        </div>\r\n    </div>\r\n</section>\r\n"
