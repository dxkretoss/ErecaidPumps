{
  "components/custom/erecaid-header": "{{!-- \r\n    ErecAid Pumps Custom Modern Header Component\r\n    Matches Screenshot 2 design 100%:\r\n    - Top Utility Row: Extracted Logo (ErecaidPumps.com + Tagline), Phone Support (Call Us 866-496-7359), Rectangular Search Bar, Wireframe Cart\r\n    - Navigation Bar: 100% Screenshot 2 Reference Match (Clean horizontal static bar in medical navy blue)\r\n    - Dynamic BigCommerce navigation is preserved in comments as requested.\r\n--}}\r\n<header class=\"erecaid-header\" role=\"banner\" data-erecaid-header>\r\n    {{!-- Top Utility / Brand Section --}}\r\n    <div class=\"erecaid-header__top\">\r\n        <div class=\"container erecaid-header__top-inner\">\r\n            {{!-- Left: Brand Logo & Tagline (Extracted from Screenshot 2) --}}\r\n            <div class=\"erecaid-header__brand\">\r\n                <a href=\"{{urls.home}}\" class=\"erecaid-header__logo-link\" aria-label=\"ErecAidPumps.com Home\">\r\n                    <img class=\"erecaid-header__logo-img\" \r\n                         src=\"https://cdn11.bigcommerce.com/s-xm5229z/images/stencil/original/image-manager/erecaidpumps.com-logo-with-tagline-2-.png?t=1793619168\" \r\n                         alt=\"ErecAidPumps.com - {{#if theme_settings.custom_header_tagline}}{{theme_settings.custom_header_tagline}}{{else}}Trusted Products. Real Support. Better Tomorrows.{{/if}}\" \r\n                         width=\"225\" \r\n                         height=\"40\">\r\n                </a>\r\n            </div>\r\n\r\n            {{!-- Right Actions: Phone Support, Search Bar, Cart --}}\r\n            <div class=\"erecaid-header__actions\">\r\n                {{!-- Phone / Specialist Support Box --}}\r\n                <a href=\"tel:{{#if theme_settings.custom_header_phone}}{{theme_settings.custom_header_phone}}{{else}}866-496-7359{{/if}}\" class=\"erecaid-header__phone-box\">\r\n                    <div class=\"erecaid-header__phone-icon\" aria-hidden=\"true\">\r\n                        <svg width=\"22\" height=\"22\" viewBox=\"0 0 24 24\" fill=\"#002d62\">\r\n                            <path d=\"M6.62 10.79a15.053 15.053 0 006.59 6.59l2.2-2.2a1 1 0 011.01-.24c1.12.37 2.33.57 3.58.57a1 1 0 011 1V20a1 1 0 01-1 1A17 17 0 013 4a1 1 0 011-1h3.5a1 1 0 011 1c0 1.25.2 2.45.57 3.58a1 1 0 01-.25 1.01l-2.2 2.2z\"/>\r\n                        </svg>\r\n                    </div>\r\n                    <div class=\"erecaid-header__phone-content\">\r\n                        <span class=\"erecaid-header__phone-title\">\r\n                            Call Us <strong>{{#if theme_settings.custom_header_phone}}{{theme_settings.custom_header_phone}}{{else}}866-496-7359{{/if}}</strong>\r\n                        </span>\r\n                        <span class=\"erecaid-header__phone-sub\">\r\n                            {{#if theme_settings.custom_header_sub1}}{{theme_settings.custom_header_sub1}}{{else}}Talk to a Product Specialist{{/if}}\r\n                        </span>\r\n                        <span class=\"erecaid-header__phone-hours\">\r\n                            {{#if theme_settings.custom_header_sub2}}{{theme_settings.custom_header_sub2}}{{else}}Mon – Fri 8am – 5pm CT{{/if}}\r\n                        </span>\r\n                    </div>\r\n                </a>\r\n\r\n                {{!-- Search Bar (Subtle Rounded Rectangle - Matches Screenshot 2) --}}\r\n                <div class=\"erecaid-header__search-wrap\" data-prevent-quick-search-close>\r\n                    <form class=\"erecaid-header__search-form\" action=\"{{urls.search}}\">\r\n                        <input class=\"erecaid-header__search-input\" data-search-quick name=\"search_query\" placeholder=\"{{#if theme_settings.custom_header_search_placeholder}}{{theme_settings.custom_header_search_placeholder}}{{else}}Search products...{{/if}}\" autocomplete=\"off\" aria-label=\"Search products\">\r\n                        <button type=\"submit\" class=\"erecaid-header__search-btn\" aria-label=\"Submit search\">\r\n                            <svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#002d62\" stroke-width=\"2.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\r\n                                <circle cx=\"11\" cy=\"11\" r=\"8\"></circle>\r\n                                <line x1=\"21\" y1=\"21\" x2=\"16.65\" y2=\"16.65\"></line>\r\n                            </svg>\r\n                        </button>\r\n                    </form>\r\n                </div>\r\n\r\n                {{!-- Minimalist Cart Icon (Matches Screenshot 2 Wireframe Cart) --}}\r\n                <div class=\"erecaid-header__cart-wrap\">\r\n                    <a class=\"erecaid-header__cart-link\" href=\"{{urls.cart}}\" data-cart-preview data-dropdown=\"cart-preview-dropdown\" data-options=\"align:right\" title=\"{{lang 'common.cart'}}\" aria-label=\"Cart\">\r\n                        <svg class=\"erecaid-header__cart-icon\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#002d62\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\r\n                            <circle cx=\"9\" cy=\"21\" r=\"1.5\"></circle>\r\n                            <circle cx=\"19\" cy=\"21\" r=\"1.5\"></circle>\r\n                            <path d=\"M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6\"></path>\r\n                        </svg>\r\n                        {{#if cart.num_items}}\r\n                            <span class=\"erecaid-header__cart-count cart-quantity\">{{cart.num_items}}</span>\r\n                        {{/if}}\r\n                    </a>\r\n                    <div class=\"dropdown-menu\" id=\"cart-preview-dropdown\" data-dropdown-content aria-hidden=\"true\"></div>\r\n                </div>\r\n\r\n                {{!-- Mobile Hamburger Toggle --}}\r\n                <button class=\"erecaid-header__mobile-toggle\" data-mobile-menu-toggle=\"menu\" aria-labe